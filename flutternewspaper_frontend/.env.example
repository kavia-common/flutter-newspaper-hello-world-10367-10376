# Copy this file to `.env` for local development (do not commit real secrets).
#
# This project uses flutter_dotenv to load environment variables at runtime.
# In CI/deploy/app previews, environment injection may be handled by the platform.

# News API key (if the app is configured to call NewsAPI.org)
NEWS_API_KEY=your_key_here

# Optional: base URL overrides (if supported by the app)
NEWS_API_BASE_URL=https://newsapi.org
