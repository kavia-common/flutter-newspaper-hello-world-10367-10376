<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Minimum iOS permission string required when Face ID may be used.
	  local_auth reads this key to display the system prompt.
	-->
	<key>NSFaceIDUsageDescription</key>
	<string>This app uses Face ID to authenticate you before showing the news.</string>

	<!--
	  Required for system passcode fallback on iOS when using LocalAuthentication
	  with deviceOwnerAuthentication / device credentials.
	  local_auth reads this key to display the system prompt when biometrics
	  are unavailable or fail.
	-->
	<key>NSLocalAuthenticationUsageDescription</key>
	<string>This app uses your device passcode to authenticate you before showing the news.</string>

	<!-- Local notifications: iOS will prompt for permission; this string is shown in some system UI contexts. -->
	<key>NSUserNotificationUsageDescription</key>
	<string>This app sends notifications when you save an article, with quick actions to open saved news or undo.</string>
</dict>
</plist>
